# --- Database ---
# SQLite is the default for local/dev runs (zero setup). Point this at a
# Set this to postgresql+psycopg://user:password@localhost:5432/fraudshield
# to use PostgreSQL (the psycopg driver is included in backend requirements).
FRAUDSHIELD_DB_URL=sqlite:///./fraudshield.db

# --- Graph store ---
# kuzu is an embedded graph database (no server process needed) used as the
# local-first substitute for Neo4j. Point GRAPH_BACKEND=neo4j and fill in
# the URI/credentials below to use a real Neo4j instance instead.
GRAPH_BACKEND=kuzu
KUZU_DB_PATH=./data/graph_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Vector store (RAG) ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- LLM provider (used only by Investigation / Report Architect agents) ---
# Free-tier Gemini has real rate limits (as low as 10 RPM / 500 RPD on
# gemini-2.5-flash). The agent pipeline is designed so LLM calls only ever
# happen once per flagged case, never per-transaction. See
# backend/app/agents/llm_client.py for the request-budget + backoff logic.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-key-here
LLM_MAX_REQUESTS_PER_DAY=400
LLM_MAX_REQUESTS_PER_MINUTE=10

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
